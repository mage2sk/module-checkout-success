<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Panth\CheckoutSuccess\Block\Success"
                   name="panth.checkout.success"
                   template="Panth_CheckoutSuccess::success.phtml"
                   cacheable="false"
                   before="-">
                <block class="Magento\Sales\Block\Order\Totals"
                       name="order_totals"
                       template="Magento_Sales::order/totals.phtml"/>
            </block>
        </referenceContainer>
    </body>
</page>
